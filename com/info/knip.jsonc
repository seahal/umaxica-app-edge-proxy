{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Knip boundary for ONE deployment unit: com/info (Astro on Cloudflare Workers).
  // Astro discovers `src/pages/**` by convention; `astro.config.mjs` is the
  // config entry. Wrangler bindings live in `wrangler.jsonc` (no `main` — the
  // adapter emits the Worker entry).
  "entry": [
    "src/pages/**/*.{ts,astro}",
    "src/**/*.astro",
    "test/**/*.test.ts",
    "e2e/**/*.spec.ts",
    "test-astro/**/*.mjs"
  ],

  "project": ["**/*.{ts,css,astro,mjs}"],

  "astro": {
    "config": ["astro.config.mjs"],
    "entry": ["src/pages/**/*.{astro,ts}", "src/content.config.ts"]
  },

  "exclude": ["catalogReferences"],

  // `cloudflare` is not a package. `src/lib/env.ts` imports `cloudflare:workers`.
  "ignoreDependencies": ["cloudflare"],

  "ignoreExportsUsedInFile": true
}
