---
/*
 * The docs frame's landing page. Copy (ja + en) lives here, as it did in
 * `src/routes/index.tsx`. `src/i18n.ts` holds only the shared shell vocabulary.
 */
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { type Locale, type PageCopy } from '../../i18n';
import { brandTitle } from '../../lib/title';

const COPY: Record<Locale, PageCopy> = {
  ja: {
    siteName: 'UMAXICA ドキュメント',
    title: 'Docs',
    heading: '使い方と技術情報をまとめています',
    description: 'Documentation for the UMAXICA platform.',
    paragraphs: [
      'サービスの設定手順、API リファレンス、運用上の注意点を掲載しています。目的の項目が見つからない場合はヘルプをご利用ください。',
    ],
  },
  en: {
    siteName: 'UMAXICA Documentation',
    title: 'Docs',
    heading: 'Guides and technical reference',
    description: 'Documentation for the UMAXICA platform.',
    paragraphs: [
      'Setup procedures, API reference, and operational notes are published here. If you cannot find what you are looking for, please use Help.',
    ],
  },
};

const lang = 'en' satisfies Locale;
const copy = COPY[lang];
---
<Base locale={lang} title={brandTitle(copy.title)} description={copy.description} pagePath="/">
  <PageHero
  siteName={copy.siteName}
  title={copy.heading}
  paragraphs={copy.paragraphs}
  actionHref="/en/entries/"
  actionLabel="View published entries"
/>
</Base>
