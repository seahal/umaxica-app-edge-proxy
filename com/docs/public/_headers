# Headers for the files Cloudflare serves BEFORE this Worker runs.
#
# Static assets never reach `src/security-headers.ts`, so anything not stated
# here is served with no security headers at all. That used to include
# `/favicon.svg`, which is the case that matters: an SVG is a document the
# browser executes script from when it is navigated to directly, and it was
# answered from the application's own origin with neither a `nosniff` nor a
# policy to bound it.
#
# Cloudflare applies every matching block, so the specific blocks below add to
# this floor rather than replacing it.
#
# The floor is deliberately three response headers and NO `Content-Security-Policy`.
# A CSP here would be inert on the subresources it mostly matches — a policy sent
# with a `.js` or `.css` file does not govern the document that loaded it — and
# actively harmful on `/service-worker.js`, where the response's own CSP DOES
# govern the worker's execution context: a `default-src 'none'` there would block
# the `fetch()` and `caches` calls the offline fallback is made of. The policy is
# scoped to the one file that is a document instead.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Navigating to an SVG on this origin renders it as a document with full script
# execution in the origin. Today's file is two shapes and no script; this block
# is what keeps that true of whatever replaces it.
/favicon.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/service-worker.js
  Cache-Control: no-cache,no-store,must-revalidate
  Content-Type: application/javascript; charset=utf-8
