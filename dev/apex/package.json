{
  "name": "umaxica-apps-edge-dev-apex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite dev --port 5501 --host",
    "build": "CLOUDFLARE_ENV= vite build",
    "preview": "pnpm run build && CLOUDFLARE_ENV= vite preview",
    "deploy": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "deploy:upload": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --config wrangler.jsonc --yes",
    "upload:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareBindings",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:stress": "vitest run --sequence.shuffle --no-cache",
    "test:api": "node api/run.mjs",
    "test:e2e": "playwright test",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "oxlint --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run check:static && pnpm run test",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check:generated": "pnpm run cf-typegen && CLOUDFLARE_ENV= wrangler types --env-interface CloudflareBindings --check",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run check:generated && pnpm run typecheck && pnpm run knip",
    "check:size": "size-limit"
  },
  "dependencies": {
    "@hono/structured-logger": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@orangeopensource/hurl": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
