#!/usr/bin/env bash
set -euo pipefail

use_rails=false
use_tunnel=false
for argument in "$@"; do
  case "${argument}" in
    --rails) use_rails=true ;;
    --tunnel) use_tunnel=true ;;
    *) echo "Usage: $0 [--rails] [--tunnel]" >&2; exit 2 ;;
  esac
done

if [[ ${EUID} -eq 0 || -n ${SUDO_UID:-} ]]; then
  echo 'ERROR: the Edge environment must be started with rootless Podman, never root or sudo.' >&2
  exit 1
fi
if ! rootless=$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null) || [[ ${rootless} != true ]]; then
  echo 'ERROR: rootless Podman is unavailable. Check `podman info` as your normal user.' >&2
  exit 1
fi

mapfile -t unmasked_env_files < <(
  find . \
    -path './.git' -prune -o \
    -path './node_modules' -prune -o \
    -path './.claude' -prune -o \
    -type f \( \
      -name '.dev.vars' -o \
      -name '.env.local' -o \
      -name '.env.test.local' -o \
      -name '.env.production.local' \
    \) -print
)
if ((${#unmasked_env_files[@]} > 0)); then
  echo 'ERROR: unmasked ignored environment files would enter through the workspace bind:' >&2
  printf '  %s\n' "${unmasked_env_files[@]}" >&2
  echo 'Move dedicated credential inputs under .secrets/ and register them with Podman Secret.' >&2
  exit 1
fi

# The local override is optional by contract. `compose.yaml` plus
# `.devcontainer/compose.yaml` are the complete standard environment -- between
# them they carry the SELinux `label=disable` and the `GH_TOKEN` passthrough that
# used to live in the overlay -- so a fresh clone starts here, and
# `.devcontainer/devcontainer.json` loads exactly those two files for the same
# reason.
#
# `compose.override.yaml` is gitignored and never created automatically. Load
# it when it happens to exist, so this script and a bare `docker compose`
# (which auto-discovers the same file when no `-f` is given) agree.
#
# `compose.custom.yaml` was the old name. If you still have one, rename it:
#   mv compose.custom.yaml compose.override.yaml
# and delete any `label=disable` / `GH_TOKEN` from your copy -- `security_opt`
# entries are appended, so a restated `label=disable` now fails the merge with
# `services.core.security_opt items at 0 and 1 are equal`.
if [[ -e compose.custom.yaml && ! -e compose.override.yaml ]]; then
  echo 'NOTE: compose.custom.yaml is the retired name and is no longer loaded.' >&2
  echo '  mv compose.custom.yaml compose.override.yaml   # then drop label=disable/GH_TOKEN from it' >&2
fi

# `core` is defined in `.devcontainer/compose.yaml`, not in `compose.yaml`: that
# split is what lets a bare `podman compose up` bring up the shared services
# without a workspace container nobody asked for. This script wants `core`, so it
# names both files. Both declare the same project name, so this is still the one
# project the Dev Container and a bare `podman compose` address.
compose=(podman compose -f compose.yaml -f .devcontainer/compose.yaml)
if [[ -e compose.override.yaml ]]; then
  compose+=(-f compose.override.yaml)
fi
services=(core)

# Podman invents a missing bind source as a DIRECTORY. For known_hosts that
# would silently create `~/.ssh/known_hosts/` on the HOST and leave every later
# `ssh` reading an empty file it cannot explain, so refuse before starting.
#
# Only relevant when the local override actually mounts it: that bind is opt-in
# precisely because a host without the file cannot support it, and the standard
# environment must not fail for a file it never touches.
if [[ -e compose.override.yaml ]] && grep -q 'known_hosts' compose.override.yaml &&
  [[ ! -f ${HOME}/.ssh/known_hosts ]]; then
  echo "ERROR: compose.override.yaml binds ${HOME}/.ssh/known_hosts, which is not a regular file." >&2
  echo 'Podman would create a directory there. Create it, or drop the bind from your override.' >&2
  echo '  ssh-keyscan github.com >> ~/.ssh/known_hosts' >&2
  exit 1
fi

# No ssh-agent socket is forwarded by the standard environment: binding one is
# a per-host fact (the socket path exists on some machines and not others, and a
# stale value fails the bind before any container starts), so it belongs in your
# own `compose.override.yaml`. Say so once, because silence would be the wrong
# answer to "why does git ask for a password inside the container?".
if [[ ! -e compose.override.yaml ]] || ! grep -q '/ssh-agent' compose.override.yaml; then
  echo 'NOTE: no ssh-agent socket is forwarded; Git over SSH will not work in the container.' >&2
  echo '  Use gh/HTTPS, or copy the commented bind out of compose.override.yaml.example:' >&2
  echo '    cp compose.override.yaml.example compose.override.yaml' >&2
fi

# Optional by design -- compose falls back to an empty token -- but the same
# reasoning applies.
if [[ -z ${GH_TOKEN:-} ]]; then
  echo 'WARNING: GH_TOKEN is unset; the gh CLI will fall back to its in-image state.' >&2
  echo '  export GH_TOKEN="$(gh auth token)"' >&2
fi

if [[ ${use_rails} == true ]]; then
  if [[ -z ${EDGE_RAILS_NETWORK:-} ]]; then
    echo 'ERROR: --rails requires EDGE_RAILS_NETWORK to name the existing Rails rootless Podman network.' >&2
    echo 'Inspect available networks with: podman network ls' >&2
    exit 1
  fi
  if ! podman network exists "${EDGE_RAILS_NETWORK}"; then
    echo "ERROR: Rails network does not exist: ${EDGE_RAILS_NETWORK}" >&2
    echo 'Inspect available networks with `podman network ls`, then set EDGE_RAILS_NETWORK.' >&2
    exit 1
  fi
fi

# A remotely managed connector token is base64-encoded JSON whose `t` field is the
# tunnel UUID. Decoding it needs no credential and reveals nothing secret: the UUID
# is the tunnel's dashboard identifier. Printing anything else from the token is
# not acceptable. Cloudflare's tokens carry no `=` padding, so restore it before
# decoding; `base64 -d` rejects an unpadded string.
tunnel_uuid_of() {
  local token=${1-} padded
  [[ -z ${token} ]] && return 1
  padded=${token}
  while ((${#padded} % 4)); do padded+='='; done
  printf '%s' "${padded}" | base64 -d 2>/dev/null |
    grep -oE '"t"[[:space:]]*:[[:space:]]*"[0-9a-fA-F-]+"' |
    head -n 1 |
    grep -oE '[0-9a-fA-F-]{36}'
}

# Independent of --rails on purpose: inbound Edge exposure and outbound Rails
# connectivity answer different questions. The connector is defined in
# `compose.yaml` because it is shared, so this adds no overlay — it only asks for
# the service to be started. It uses this compose project's default network and
# requires this repository's own tunnel token from `.env`.
if [[ ${use_tunnel} == true ]]; then
  # Compose reads the repo-root `.env` itself; bash does not. Check the
  # environment and the file, or a token that is present and working would be
  # reported as missing.
  edge_token=${CLOUDFLARED_TOKEN:-}
  if [[ -z ${edge_token} && -f .env ]]; then
    edge_token=$(sed -n 's/^CLOUDFLARED_TOKEN=//p' .env | tail -n 1)
    edge_token=${edge_token%\"}
    edge_token=${edge_token#\"}
    edge_token=${edge_token%\'}
    edge_token=${edge_token#\'}
  fi
  if [[ -z ${edge_token} ]]; then
    echo 'ERROR: --tunnel requires CLOUDFLARED_TOKEN in .env.' >&2
    echo "  It must be this repository's OWN tunnel token. Global uses the same" >&2
    echo '  variable name in its own .env, for a different tunnel.' >&2
    exit 1
  fi

  # The variable name is shared with Global by design (one name, one tunnel per
  # repository, each from its own `.env`), so the name cannot catch a copied
  # value. This does: two connectors on one tunnel is the 2026-09-04 failure, and
  # Cloudflare cannot detect it — a replica that cannot reach the origin looks
  # healthy from the edge. Compare the tunnel UUID instead, against every
  # cloudflared container already on this host.
  edge_uuid=$(tunnel_uuid_of "${edge_token}" || true)
  if [[ -z ${edge_uuid} ]]; then
    echo 'ERROR: CLOUDFLARED_TOKEN is not a decodable connector token.' >&2
    echo '  Expected the base64 token from the tunnel dashboard, not a tunnel name,' >&2
    echo '  UUID, or Cloudflare API token.' >&2
    exit 1
  fi
  while read -r other; do
    [[ -z ${other} ]] && continue
    other_token=$(podman inspect "${other}" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null |
      sed -n 's/^TUNNEL_TOKEN=//p' | head -n 1)
    [[ $(tunnel_uuid_of "${other_token}" || true) == "${edge_uuid}" ]] || continue
    echo "ERROR: tunnel ${edge_uuid} already has a connector on this host: ${other}" >&2
    echo '  Two connectors on one tunnel is not a valid setup here. Cloudflare routes' >&2
    echo '  to the nearest replica and cannot tell that one of them has no route to' >&2
    echo '  its origin, so both repositories fail intermittently. Give this' >&2
    echo '  repository its own tunnel and put that tunnel token in .env.' >&2
    exit 1
  done < <(podman ps --format '{{.Names}}' 2>/dev/null | grep -i cloudflare || true)

  services+=(cloudflare-tunnel)
fi

# There is no credential overlay any more. Long-lived API tokens and Podman
# Secrets were retired. GitHub access is the host's, borrowed rather than copied
# -- `GH_TOKEN` forwarded by `compose.yaml` as `${GH_TOKEN:-}` and, optionally,
# an ssh-agent socket from your own `compose.override.yaml`, with no key file
# and no token literal anywhere in the repository. Everything else
# is a short-lived credential obtained inside the container:
#   scripts/wrangler-login
#   claude   # /login
#   codex login
# None of those is persisted: recreating the container requires logging in again.

"${compose[@]}" up -d "${services[@]}"
