---
/*
 * The info frame's landing page. Copy lives here (ja + en), exactly as it lived
 * in `src/routes/index.tsx` on the TanStack unit — `src/i18n.ts` holds only the
 * shell vocabulary every frame shares.
 */
import PageHero from '../../components/PageHero.astro';
import PublishedEntries from '../../islands/PublishedEntries.tsx';
import Base from '../../layouts/Base.astro';
import { type Locale, type PageCopy } from '../../i18n';
import { brandTitle } from '../../lib/title';

const COPY: Record<Locale, PageCopy> = {
  ja: {
    siteName: 'UMAXICA インフォメーション',
    title: 'Info',
    heading: 'サービスに関するご案内',
    description: 'Information about the UMAXICA platform.',
    paragraphs: [
      '提供中のサービス内容、利用条件、各種お手続きについてご案内しています。内容は予告なく変更される場合があります。',
    ],
  },
  en: {
    siteName: 'UMAXICA Information',
    title: 'Info',
    heading: 'Service information',
    description: 'Information about the UMAXICA platform.',
    paragraphs: [
      'This site covers the services UMAXICA currently offers, their conditions of use, and the procedures related to them. The content may change without notice.',
    ],
  },
};

const lang = 'ja' satisfies Locale;
const copy = COPY[lang];
---
<Base locale={lang} title={brandTitle(copy.title)} description={copy.description} pagePath="/">
  <PageHero
  siteName={copy.siteName}
  title={copy.heading}
  paragraphs={copy.paragraphs}
  actionHref="/ja/entries/"
  actionLabel="公開エントリーを見る"
/>
  <PublishedEntries client:load locale="ja" />
</Base>
