{
  "name": "umaxica-apps-edge-app-help",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EDGE_LOCAL_NODE_RUNTIME=1 CLOUDFLARE_ENV=local PUBLIC_REGION=jp astro dev --port 5408 --host",
    "dev:vpc": "CLOUDFLARE_ENV=vpc PUBLIC_REGION=jp astro dev --port 5408 --host",
    "build": "CLOUDFLARE_ENV= PUBLIC_REGION=jp astro build",
    "preview": "pnpm run build && node ../../tools/preview-astro-worker.mjs --port 5408",
    "deploy": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "deploy:upload": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --config wrangler.jsonc --yes",
    "upload:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "typecheck": "pnpm run cf-typegen && astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:stress": "vitest run --sequence.shuffle --no-cache",
    "test:api": "node api/run.mjs",
    "test:e2e": "playwright test",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "oxlint --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run check:static && pnpm run test",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check:generated": "pnpm run cf-typegen && CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run check:generated && pnpm run typecheck && pnpm run knip",
    "check:size": "size-limit",
    "verify:seo": "pnpm run build && node test-astro/verify-seo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@fontsource-variable/inter": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@orangeopensource/hurl": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
