---
export const prerender = false;

import { RAILS_STAFF_ORIGIN } from 'astro:env/server';

import Base from '../../../layouts/Base.astro';
import { brandTitle } from '../../../lib/title';
import {
  entriesIndexPath,
  entryPublicPath,
  parsePublicPageQuery,
  publishingErrorResponse,
  publishingHttpStatus,
  railsLocaleFromPathLang,
  resolvePublishingApi,
  type PublishingResult,
} from '../../../lib/publishing-api';
import { PUBLISHING_NAMESPACE, PUBLISHING_SURFACE } from '../../../lib/publishing-cell';
import { managementIndexUrl } from '../../../lib/publishing-management';
import type { RailsEntriesPage } from '../../../lib/rails-entries';

const COPY = {
  ja: {
    title: 'エントリー',
    heading: '公開エントリー',
    description: '公開されているエントリーの一覧です。',
    empty: '公開エントリーはまだありません。',
    previous: '前のページ',
    next: '次のページ',
    pagination: 'ページ送り',
    manage: '管理',
  },
  en: {
    title: 'Entries',
    heading: 'Published entries',
    description: 'A list of published entries.',
    empty: 'No published entries yet.',
    previous: 'Previous',
    next: 'Next',
    pagination: 'Pagination',
    manage: 'Manage',
  },
} as const;

const NO_STORE = 'no-store';
const lang = railsLocaleFromPathLang(Astro.params.lang);
Astro.response.headers.set('Cache-Control', NO_STORE);

const pageQuery = parsePublicPageQuery(Astro.url.searchParams.get('page'));

let result: PublishingResult<RailsEntriesPage>;
if (lang === null) {
  result = { kind: 'not-found', upstreamStatus: 404 };
} else if (pageQuery.kind === 'invalid') {
  result = { kind: 'bad-request' };
} else {
  try {
    const api = resolvePublishingApi();
    if ('kind' in api) {
      result = api;
    } else {
      result = await api.fetchEntriesPage(
        pageQuery.kind === 'omitted' ? { locale: lang } : { locale: lang, page: pageQuery.page },
      );
    }
  } catch {
    result = { kind: 'internal-error' };
  }
}

if (result.kind !== 'ok' || lang === null) {
  return publishingErrorResponse(publishingHttpStatus(result), lang ?? 'en');
}

const copy = COPY[lang];
const page = result.value;
const canonicalSearch = page.page.current > 1 ? `page=${String(page.page.current)}` : undefined;
const manageHref = managementIndexUrl(RAILS_STAFF_ORIGIN, PUBLISHING_NAMESPACE, PUBLISHING_SURFACE);
---
<Base
  locale={lang}
  title={brandTitle(copy.title)}
  description={copy.description}
  pagePath="/entries"
  canonicalSearch={canonicalSearch}
>
  <main class="mx-auto grid w-full max-w-4xl flex-1 gap-6 px-6 py-12" id="main-content" tabindex="-1">
    <h1 class="text-3xl leading-heading font-semibold">{copy.heading}</h1>
    <p>
      <a class="underline" href={manageHref}>{copy.manage}</a>
    </p>
    {page.data.length === 0 ? (
      <p>{copy.empty}</p>
    ) : (
      <ul class="grid gap-4">
        {page.data.map((entry) => (
          <li>
            <a class="text-lg font-medium underline" href={entryPublicPath(lang, entry.public_id)}>
              {entry.title}
            </a>
            {entry.summary && <p class="text-gray-700">{entry.summary}</p>}
          </li>
        ))}
      </ul>
    )}
    {(page.page.previous !== null || page.page.next !== null) && (
      <nav aria-label={copy.pagination}>
        <ul class="flex flex-wrap gap-4">
          {page.page.previous !== null && (
            <li>
              <a class="underline" href={entriesIndexPath(lang, page.page.previous)} rel="prev">
                {copy.previous}
              </a>
            </li>
          )}
          {page.page.next !== null && (
            <li>
              <a class="underline" href={entriesIndexPath(lang, page.page.next)} rel="next">
                {copy.next}
              </a>
            </li>
          )}
        </ul>
      </nav>
    )}
  </main>
</Base>
