---
/*
 * The shell every document on this unit renders inside — ported from
 * `src/routes/__root.tsx` plus the head tags that `head()` returned.
 *
 * SEO / indexing (plan §6b): `<title>`, `<meta name="description">`,
 * `<link rel="canonical">` and the hreflang alternates are emitted here at
 * build time, in the initial HTML, with no JavaScript. The only script on the
 * page is the service-worker registration, and it is progressive — the page is
 * complete without it.
 *
 * Security headers, including the CSP, are set in `public/_headers` and
 * matched by Cloudflare before the Worker runs. With `inlineStylesheets: 'never'`
 * and no `is:inline` script, every script and style is a same-origin file, so
 * the policy is `script-src 'self'` / `style-src 'self'` — the same policy the
 * TanStack unit set per-request, minus the nonce it no longer needs.
 */
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import { CANONICAL_ORIGIN } from '../lib/canonical';
import { DEFAULT_LOCALE, LOCALES, SHELL, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The path with no locale prefix, e.g. `/` or `/about`. */
  pagePath: string;
  /**
   * Canonical / hreflang query without `?`, e.g. `page=2`. Page 1 of a
   * collection omits this so the natural URL stays `/{lang}/entries/`.
   */
  canonicalSearch?: string;
  /**
   * A route that exists at a single URL with no locale prefix (the SW offline
   * fallback, the 404 document). No hreflang alternates; canonical is the page
   * itself.
   */
  localeless?: boolean;
}

const { locale, title, description, pagePath, localeless = false, canonicalSearch } = Astro.props;
const t = SHELL[locale];

// Content pages use the trailing-slash form for canonical / hreflang / nav.
const normalizedPath = pagePath === '/' ? '' : pagePath.replace(/\/$/u, '');
const search = canonicalSearch ? `?${canonicalSearch}` : '';
const localePath = (l: string) => `/${l}${normalizedPath}/${search}`;
const canonical = localeless
  ? new URL(pagePath, CANONICAL_ORIGIN).href
  : new URL(localePath(locale), CANONICAL_ORIGIN).href;
const alternates = localeless
  ? []
  : LOCALES.map((l) => ({ hreflang: l, href: new URL(localePath(l), CANONICAL_ORIGIN).href }));
const xDefault = new URL(localePath(DEFAULT_LOCALE), CANONICAL_ORIGIN).href;
---
<!doctype html>
<html lang={locale} dir={t.htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!localeless && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 leading-body text-gray-900">
    <SkipLink label={t.skipToMain} />
    <SiteHeader brand={t.brand} homeHref={`/${locale}/`} />
    <slot />
    <SiteFooter
      utilityNavLabel={t.utilityNavLabel}
      aboutLink={t.aboutLink}
      aboutHref={`/${locale}/about/`}
    />
    {/* Progressive enhancement only (plan §6b). `is:inline src` keeps it a
        static same-origin file so the CSP stays `script-src 'self'`. */}
    <script is:inline src="/sw-register.js" defer></script>
  </body>
</html>
